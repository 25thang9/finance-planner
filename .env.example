# Từ Neon Connect: kết nối pooled (có -pooler ở hostname)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Từ Neon Connect: kết nối direct, cùng PROJECT + BRANCH + DATABASE
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Tạo bằng: openssl rand -base64 32 (ít nhất 32 ký tự)
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"
# Tuỳ chọn: đăng nhập GitHub. Xem README để tạo OAuth App
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Tuỳ chọn: seed tài khoản demo, nên đặt password riêng và không commit
DEMO_EMAIL="demo@financeplanner.local"
DEMO_PASSWORD=""
